# Google Cloud: enable Places API (New) and restrict the key to this app's server environment.
GOOGLE_MAPS_API_KEY=

# Supabase Auth + CRM
# The URL and anon key are safe to expose to the browser; the service role key is never exposed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Claude AI proposal generator. Keep this server-side only.
ANTHROPIC_API_KEY=
# Optional override. The app dynamically falls back to models available on the configured API key.
# ProfitPnL uses claude-sonnet-5 as its preferred model.
ANTHROPIC_MODEL=claude-sonnet-5

# Optional booking page link used in Claude proposals and follow-ups.
WEB4FIRM_BOOKING_URL=

# Optional: required only when you want the Send Email button to send via Resend.
RESEND_API_KEY=
SENDER_EMAIL=Web4Firm <hello@your-verified-domain.com>
